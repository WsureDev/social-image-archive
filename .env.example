# Copy to .env and replace placeholders with your own deployment values.
QUEUE_WORKER_URL=https://your-worker.example.com
CF_ACCOUNT_ID=
CF_QUEUE_ID=
# Use an Account > Queues > Edit API token, or configure Wrangler OAuth below.
CLOUDFLARE_API_TOKEN=
# Host CLI archive path; the example Compose mounts this project's ./data-docker.
ARCHIVE_DIR=./data-docker
HOST=0.0.0.0
PORT=19280
POLL_SECONDS=60
# For OAuth, set the absolute path to your Wrangler login directory.
# With an API token, leave this default and create the empty directory.
WRANGLER_AUTH_DIR=./.wrangler-auth
# Optional HTTP proxy. Empty means direct connections.
ARCHIVE_HTTP_PROXY=
ARCHIVE_NO_PROXY=localhost,127.0.0.1
# Set these to the owner UID/GID of your archive, auth and state directories.
LOCAL_UID=1000
LOCAL_GID=1000
MCP_MAX_PICK=3
MCP_TRUST_PROXY=false
